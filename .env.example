# Parent Control — example configuration. Copy values into your shell or CI secrets.
# NEVER commit a real .env. Only placeholder values belong in this file.

# Supabase project (client-safe values only)
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=YOUR_PUBLISHABLE_ANON_KEY

# Optional STUN fallback used when the backend has not configured a TURN server.
STUN_URL=stun:stun.l.google.com:19302

# Server-side secrets (set with `supabase secrets set`, never in Flutter):
#   SUPABASE_SERVICE_ROLE_KEY  (auto-injected by Supabase Edge Functions)
#   TURN_URL=turn:turn.example.com:3478
#   TURN_SECRET=replace-with-a-long-random-shared-secret
#   TURN_TTL_SECONDS=600
