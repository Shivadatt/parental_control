	    requested_at, accepted_at, expires_at, consent_recorded, session_nonce
	  ) values (
	    '50000000-0000-4000-8000-000000000007', v_family1, v_device7,
	    v_parent1, v_child3, 'video', 'active',
	    now() - interval '2 minutes', now() - interval '1 minute',
